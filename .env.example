# Set these in hPanel → Node.js app → Environment variables (never commit real values)
PORT=3000
# development | test | production — dev-login is off in "production"; the webhook test key works only in development/test
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_timeclock
DB_USER=u123456789_tcuser
DB_PASSWORD=change-me
GHL_SHARED_SECRET=from-ghl-app-advanced-settings-auth
SESSION_SECRET=random-string-at-least-32-chars
# GHL Marketplace app (all optional; without them /oauth/callback answers 503)
# Client ID from the app's Advanced Settings in the GHL Marketplace
GHL_CLIENT_ID=from-ghl-marketplace-app
# Client secret from the same page (keep private)
GHL_CLIENT_SECRET=from-ghl-marketplace-app
# 64 hex chars that encrypt stored OAuth tokens: openssl rand -hex 32
TOKEN_ENC_KEY=64-hex-chars-from-openssl-rand-hex-32
# Redirect URL registered in the app (default https://timeclock.noursky.com/oauth/callback)
GHL_REDIRECT_URI=https://timeclock.noursky.com/oauth/callback
# The app's own id: install/uninstall webhooks from other apps are ignored. Set it in production
GHL_APP_ID=from-ghl-marketplace-app
# Leave empty if the React UI is served from this same app (no CORS needed)
ALLOWED_ORIGIN=
